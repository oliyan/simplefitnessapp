{
  "expo": {
    "name": "Urudhi",
    "slug": "urudhi",
    "version": "1.7.15",
    "orientation": "portrait",
    "icon": "./assets/simpleicon.png",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/simpleicon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.oliyan.urudhi"
    },
    "android": {
      "versionCode": 66,
      "blockedPermissions": ["android.permission.INTERNET",
       "android.permission.RECEIVE_BOOT_COMPLETED",
       "android.permission.RECORD_AUDIO",
       "android.permission.ACCESS_NETWORK_STATE",
       "android.permission.ACCESS_WIFI_STATE" ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/simpleicon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.oliyan.urudhi"
    },
    "web": {
      "favicon": "./assets/simpleicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-build-properties",
      [
        "expo-notifications",
        {
          "icon": "./assets/notificationicon.png",
          "color": "#000000",
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ]
  }
}
