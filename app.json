{
  "expo": {
    "name": "Urudhi",
    "slug": "urudhi",
    "description": "Urudhi - by ஒளியன் கலைக்கூடம்",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/urudhi-icon.png",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/urudhi-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F1EFE2"
    },
    "ios": {
      "bundleIdentifier": "com.oliyan.urudhi"
    },
    "android": {
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/urudhi-icon.png",
        "backgroundColor": "#F1EFE2"
      },
      "package": "com.oliyan.urudhi"
    },
    "web": {
      "favicon": "./assets/urudhi-icon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-build-properties",
      [
        "expo-notifications",
        {
          "icon": "./assets/notificationicon.png",
          "color": "#000000",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-secure-store"
    ]
  }
}
